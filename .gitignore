# Local environment; keep a shared Pixi config if one is added.
/.pixi/*
!/.pixi/config.toml
/.venv/

# Raw data, generated results and historical notebook snapshots stay local.
/data/
/output/
/tmp/
/results/
/backup/
/archive/
/reports/*
!/reports/README.md
/poster/data/
/poster/tables/
/poster/figures/
/docs/figures/
/src/bacteria_analysis/_legacy/

# Handoffs belong under docs/handoffs, without root compatibility links.
/HANDOFF*.md

# Scientific figure exports and binary caches are not source code.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.pdf
*.npz
*.npy
*.parquet
*.pkl

# Python and Jupyter caches.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS and editor files.
.DS_Store
._*
*.swp
*.swo
/.vscode/
/.idea/

# Machine-local settings and credentials.
.env
.env.*
!.env.example
!.env.template
/.agent/
/.agents/
/.claude/
/.worktrees/

# Sync only the shared project state; Markdown memory remains versioned.
/state/*
!/state/project-status.json
